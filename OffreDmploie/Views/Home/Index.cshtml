</section>
<!--/ End Apply Process Area -->
<!-- Start Job Category Area -->
<section class="job-category section">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="section-title">
                    <span class="wow fadeInDown" data-wow-delay=".2s">Job list</span>
                    <h2 class="wow fadeInUp" data-wow-delay=".4s">Choose Your Desire Job</h2>
                    <p class="wow fadeInUp" data-wow-delay=".6s">
                        Il y a tant d'offres qui vous convient , 
                        Tantez votre chance 😁
                    </p>
                </div>
            </div>
        </div>
        <div class="row g-4 mb-5" id="jobsContainer">
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="col-xl-4 col-lg-6 job-item"
                         data-domaine="@item.Domaine.Nomdomaine"
                         data-contrat="@item.Typedecontrat"
                         data-lieu="@item.Lieu"
                         data-status="@item.Statusdeloffre">

                        <div class="card shadow-sm h-100 position-relative"
                             style="transition: transform 0.3s ease, box-shadow 0.3s ease; border-radius: 12px; overflow: hidden; border: none;"
                             onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 10px 20px rgba(0, 0, 0, 0.1)'"
                             onmouseout="this.style.transform='none'; this.style.boxShadow='none'">

                            <span class="badge text-white @(item.Statusdeloffre == "Ouvert" ? "status-badge-open" : "status-badge-closed")"
                                  style="position: absolute; top: 0; right: 0; border-bottom-left-radius: 8px; font-size: 0.8rem; padding: 0.3rem 0.7rem;
                          background: linear-gradient(45deg, @(item.Statusdeloffre == "Ouvert" ? "#2ecc71, #27ae60" : "#e74c3c, #c0392b"));">
                                @item.Statusdeloffre
                            </span>

                            <a asp-controller="Jobs" asp-action="Details" asp-route-id="@item.Id">
                                <div class="card-body p-4">
                                    <h5 class="mb-3" style="font-weight: 700; color: #2c3e50;">@item.NomDeLoffre</h5>
                                    <p class="text-muted mb-3"
                                       style="height: 50px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                        @item.Descriptiondeloffre
                                    </p>

                                    <div class="mb-4">
                                        <div class="d-flex align-items-center mb-2">
                                            <div style="width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 12px; background-color:#4094dc;">
                                                <i class="bi bi-building" style="color:black"></i>
                                            </div>
                                            <span>@item.Domaine.Nomdomaine</span>
                                        </div>
                                        <div class="d-flex align-items-center mb-2">
                                            <div style="width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 12px; background-color:#5fa5e2;">
                                                <i class="bi bi-briefcase" style="color:black"></i>
                                            </div>
                                            <span>@item.Typedecontrat - @item.Typedeloffre</span>
                                        </div>
                                        <div class="d-flex align-items-center mb-2">
                                            <div style="width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 12px; background-color:#7db6e7;">
                                                <i class="bi bi-flag" style="color:black"></i>
                                            </div>
                                            <span>@item.Lieu</span>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center">
                                        <div style="color: #7f8c8d; font-size: 0.9rem;">
                                            <i class="bi bi-calendar-check me-1"></i> Date limite :
                                            <strong>@item.Datefin.ToString("dd MMM yyyy")</strong>
                                        </div>
                                        <div>
                                            @if (!User.IsInRole("Candidat"))
                                            {
                                                <div class="action-buttons">
                                                    <a asp-controller="Jobs" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm me-1" title="Modifier">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <a asp-controller="Jobs" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm me-1" title="Détails">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    <a asp-controller="Jobs" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Supprimer">
                                                        <i class="bi bi-trash"></i>
                                                    </a>
                                                </div>
                                            }
                                            else
                                            {
                                                <a asp-controller="Candidatures" asp-action="Create" asp-route-id="@item.Id"
                                                   class="btn btn-primary rounded-pill px-4 py-2 fw-bold @(item.Statusdeloffre != "Ouvert" ? "disabled" : "")"
                                                   style="background: linear-gradient(45deg, #3498db, #2980b9); border: none; box-shadow: 0 4px 6px rgba(50, 50, 93, 0.11); transition: all 0.3s;"
                                                   onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 7px 14px rgba(50, 50, 93, 0.1)'; this.style.background='linear-gradient(45deg, #2980b9, #3498db)'"
                                                   onmouseout="this.style.transform='none'; this.style.boxShadow='0 4px 6px rgba(50, 50, 93, 0.11)'; this.style.background='linear-gradient(45deg, #3498db, #2980b9)'">
                                                    <i class="bi bi-send me-2"></i>Postuler
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div style="min-height: 300px; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #7f8c8d;">
                        <i class="bi bi-search fs-1 mb-3"></i>
                        <h3>Aucune offre d'emploi disponible</h3>
                        <p>Aucune offre ne correspond à vos critères de recherche.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!-- /End Job Category Area -->

<!-- End Clients Area -->

@section Scripts {

    <script>
        $(document).ready(function() {
            // Filtrage dynamique
            function filterJobs() {
                const searchTerm = $('#searchInput').val().toLowerCase();
                const domaine = $('#domaineFilter').val();
                const contrat = $('#contratFilter').val();
                const lieu = $('#lieuFilter').val();
                const status = $('#statusFilter').val();

                let visibleCount = 0;

                $('.job-item').each(function() {
                    const jobCard = $(this);
                    const jobTitle = jobCard.find('.job-title').text().toLowerCase();
                    const jobDescription = jobCard.find('.job-description').text().toLowerCase();
                    const jobDomaine = jobCard.data('domaine');
                    const jobContrat = jobCard.data('contrat');
                    const jobLieu = jobCard.data('lieu');
                    const jobStatus = jobCard.data('status');

                    const matchesSearch = jobTitle.includes(searchTerm) || jobDescription.includes(searchTerm);
                    const matchesDomaine = domaine === '' || jobDomaine === domaine;
                    const matchesContrat = contrat === '' || jobContrat === contrat;
                    const matchesLieu = lieu === '' || jobLieu === lieu;
                    const matchesStatus = status === '' || jobStatus === status;

                    if (matchesSearch && matchesDomaine && matchesContrat && matchesLieu && matchesStatus) {
                        jobCard.removeClass('d-none');
                        visibleCount++;
                    } else {
                        jobCard.addClass('d-none');
                    }
                });

                // Mise à jour du compteur
                $('#jobCount').text(visibleCount);

                // Afficher/masquer le message "aucun résultat"
                if (visibleCount === 0) {
                    $('#jobsContainer').addClass('d-none');
                    $('#noResults').removeClass('d-none');
                } else {
                    $('#jobsContainer').removeClass('d-none');
                    $('#noResults').addClass('d-none');
                }
            }

            // Événements
            $('#searchInput, #domaineFilter, #contratFilter, #lieuFilter, #statusFilter').on('input change', filterJobs);

            // Réinitialiser les filtres
            $('#resetFilters').click(function() {
                $('#searchInput').val('');
                $('#domaineFilter, #contratFilter, #lieuFilter, #statusFilter').val('');
                filterJobs();
            });

            // Animation au défilement
            $(window).on('scroll', function() {
                $('.job-card').each(function() {
                    const cardPosition = $(this).offset().top;
                    const scrollPosition = $(window).scrollTop() + $(window).height();

                    if (scrollPosition > cardPosition + 100) {
                        $(this).addClass('animate__animated animate__fadeInUp');
                    }
                });
            });
        });
    </script>
}